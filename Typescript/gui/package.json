{
  "name": "netget.gui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "netget UI components — gateway identity & monad mesh, built on this.gui",
  "main": "./dist/netget-gui.cjs",
  "module": "./dist/netget-gui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/netget-gui.es.js",
      "require": "./dist/netget-gui.cjs"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js",
      "require": "./dist/atoms/index.cjs"
    },
    "./molecules": {
      "types": "./dist/molecules/index.d.ts",
      "import": "./dist/molecules/index.js",
      "require": "./dist/molecules/index.cjs"
    },
    "./compounds": {
      "types": "./dist/compounds/index.d.ts",
      "import": "./dist/compounds/index.js",
      "require": "./dist/compounds/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/addon-themes": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "storybook": "^8.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "this.gui",
    "netget",
    "ui",
    "monad",
    "gateway",
    "identity"
  ]
}
