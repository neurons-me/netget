{
    "name": "netget",
    "version": "2.7.6",
    "description": "Rette Adepto.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "bin/",
        "dist/",
        "src/index.ts",
        "src/netget.ts",
        "src/netget.cli.ts",
        "src/modules/**/*.ts",
        "src/runtime/**/*.ts",
        "src/scripts/**/*.ts",
        "src/kernel/**/*.ts",
        "src/utils/**/*.ts",
        "src/utils/netgetPaths.js",
        "assets/main-server-ui/dist/",
        "src/htmls/NetgetErrorCodeHandler.html",
        "src/htmls/cleaker.html",
        "src/htmls/netgetX.html",
        "src/modules/NetGetX/OpenResty/lua/",
        "src/modules/NetGetX/OpenResty/netget_app.conf"
    ],
    "scripts": {
        "prebuild": "npm test",
        "start": "node --import tsx src/netget.cli.ts",
        "test": "tsx tests/exposure-policy.test.ts && tsx tests/monad-proxy-config.test.ts && tsx tests/gateway-claims.test.ts && tsx tests/gatewayIdentity.test.ts && tsx tests/gatewayUsageAggregator.test.ts && tsx tests/package-surface.test.ts && tsx tests/public-domain-ssl.test.ts && tsx tests/main-server-static-dashboard.test.ts && tsx tests/gateway-status.test.ts && tsx tests/no-live-monad.test.ts",
        "test:nrp:curl": "bash scripts/nrp-curl-tests.sh",
        "build": "tsc -p tsconfig.lib.json",
        "dev": "tsx src/netget.cli.ts",
        "dev:main": "tsx src/netget.ts",
        "type-check": "tsc --noEmit",
        "docs:api": "typedoc",
        "docs:api:watch": "typedoc --watch",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "docs:publish": "npm run docs:api && npm run docs:build && mkdir -p typedocs && touch typedocs/.nojekyll"
    },
    "bin": {
        "netget": "bin/netget"
    },
    "keywords": [
        "netget",
        "gateway",
        "networking",
        "dynamic-routing",
        "service-mesh",
        "api-gateway",
        "local-development",
        "modular-network"
    ],
    "bugs": {
        "url": "https://github.com/neurons-me/netget/issues"
    },
    "dependencies": {
        "archiver": "^8.0.0",
        "axios": "^1.12.2",
        "chalk": "^5.6.2",
        "cleaker": "^3.2.1",
        "commander": "^14.0.1",
        "form-data": "^4.0.4",
        "inquirer": "^12.10.0",
        "open": "^10.2.0",
        "pm2": "^6.0.14",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "this.gui": "^2.1.8",
        "this.me": "^3.9.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/neurons-me/netget.git"
    },
    "homepage": "https://www.npmjs.com/package/netget",
    "docs": "https://neurons-me.github.io/netget",
    "author": "Sui Gn",
    "contributors": [
        "pplalo"
    ],
    "license": "MIT",
    "repoType": "NPM Package",
    "category": "utils",
    "devDependencies": {
        "@types/express": "^5.0.3",
        "@types/node": "^24.7.0",
        "nodemon": "^3.1.10",
        "typedoc": "^0.28.16",
        "typedoc-plugin-markdown": "^4.9.0",
        "typescript": "^5.9.3",
        "vitepress": "^1.6.4"
    }
}
